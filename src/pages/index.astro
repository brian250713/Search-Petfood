---
import Layout from '../layouts/Layout.astro';
import metaData from '../../data/meta.json';
import productsData from '../../data/products.json';

const origins: string[] = [...new Set((productsData as { origin: string }[]).map((p) => p.origin).filter(Boolean))].sort();
const foodTotal = (productsData as unknown[]).length;
---

<Layout title="寵物食品資訊查詢 - 飼主開放資料工具">
  <div id="search-app" data-version={metaData.fetchedAt} style="display: flex; flex-direction: column; gap: 1.5rem;">
    <div class="card" style="background: linear-gradient(to bottom, #ffffff, var(--primary-light)); padding: 1.5rem;">
      <h1 style="font-size: 1.5rem; color: var(--primary-hover); margin-bottom: 0.5rem;">寵物食品檢索</h1>
      <p style="font-size: 0.9rem; color: #4b5563; margin-bottom: 1rem;">
        支援品名、廠商名稱、食品序號與適用寵物文字模糊搜尋，可依種類、適用寵物、產品來源與原產地篩選。（原料與營養成分請進食品詳情查看。）
      </p>

      <div style="position: relative;">
        <input
          type="text"
          id="search-input"
          class="input-text"
          placeholder="輸入品名、廠商、序號、適用寵物或種類..."
          style="font-size: 1.05rem; padding: 0.75rem 1rem; border-radius: 8px; border: 2px solid var(--primary);"
          autocomplete="off"
        />
        <div id="index-loading-badge" style="display: none; position: absolute; right: 12px; top: 12px; font-size: 0.85rem; color: var(--primary-hover); background: var(--primary-light); padding: 0.1rem 0.5rem; border-radius: 4px;">
          載入索引中...
        </div>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 260px 1fr; gap: 1.5rem; align-items: start;" id="main-content-layout">
      <button id="toggle-filter-btn" class="btn btn-secondary" style="display: none; width: 100%; margin-bottom: 0.5rem;">
        展開篩選條件 ▾
      </button>

      <aside class="card" id="filter-panel" style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <h2 style="font-size: 1.05rem; color: #111827; margin: 0;">篩選條件</h2>
          <button id="reset-filter-btn" style="background: none; border: none; color: var(--primary); cursor: pointer; font-size: 0.8rem; text-decoration: underline;">重設</button>
        </div>

        <div>
          <label style="font-size: 0.85rem; font-weight: 600; color: #374151; display: block; margin-bottom: 0.35rem;">食品種類</label>
          <select id="filter-item" class="input-text" style="font-size: 0.9rem; padding: 0.4rem;">
            <option value="">全部種類</option>
            <option value="乾飼糧">乾飼糧</option>
            <option value="罐頭">罐頭</option>
            <option value="零食">零食</option>
            <option value="補助食品">補助食品</option>
            <option value="生鮮、冷凍">生鮮、冷凍</option>
            <option value="潔牙骨">潔牙骨</option>
            <option value="半溼性飼糧(水分含量20-35％)">半溼性飼糧</option>
          </select>
        </div>

        <div>
          <label style="font-size: 0.85rem; font-weight: 600; color: #374151; display: block; margin-bottom: 0.35rem;">適用寵物</label>
          <select id="filter-pet" class="input-text" style="font-size: 0.9rem; padding: 0.4rem;">
            <option value="">犬貓皆可</option>
            <option value="犬">犬</option>
            <option value="貓">貓</option>
          </select>
        </div>

        <div>
          <label style="font-size: 0.85rem; font-weight: 600; color: #374151; display: block; margin-bottom: 0.35rem;">產品來源</label>
          <select id="filter-source" class="input-text" style="font-size: 0.9rem; padding: 0.4rem;">
            <option value="">全部來源</option>
            <option value="製造、加工">製造、加工</option>
            <option value="委託代工廠製造">委託代工廠製造</option>
            <option value="輸入">輸入</option>
            <option value="分裝">分裝</option>
          </select>
        </div>

        <div>
          <label style="font-size: 0.85rem; font-weight: 600; color: #374151; display: block; margin-bottom: 0.35rem;">原產地</label>
          <select id="filter-origin" class="input-text" style="font-size: 0.9rem; padding: 0.4rem;">
            <option value="">全部產地</option>
            {origins.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>
      </aside>

      <section style="display: flex; flex-direction: column; gap: 1rem;">
        <div id="results-meta-bar" style="font-size: 0.9rem; color: #4b5563; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem;">
          <span>查詢結果：共 <strong id="result-count" style="color: var(--primary-hover);">0</strong> 筆食品</span>
          <span id="initial-hint" style="color: #6b7280; font-size: 0.85rem;">點選搜尋框即可啟用完整檢索</span>
        </div>

        <div id="results-list" style="display: flex; flex-direction: column; gap: 0.85rem;">
          <div class="card" style="padding: 2.5rem 1rem; text-align: center; color: #6b7280;">
            <p style="font-size: 1.1rem; margin-bottom: 0.5rem; color: #374151;">請輸入關鍵字或選擇左側分類篩選</p>
            <p style="font-size: 0.85rem;">目前收錄食品約 {foodTotal.toLocaleString()} 筆，點擊搜尋框立即載入離線搜尋引擎</p>
          </div>
        </div>

        <div id="pagination-bar" style="display: none; justify-content: center; gap: 0.5rem; margin-top: 1rem;">
          <button id="prev-page-btn" class="btn btn-secondary" style="padding: 0.4rem 0.8rem;">上一頁</button>
          <span id="page-indicator" style="display: flex; align-items: center; font-size: 0.9rem; color: #374151;"></span>
          <button id="next-page-btn" class="btn btn-secondary" style="padding: 0.4rem 0.8rem;">下一頁</button>
        </div>
      </section>
    </div>
  </div>

  <style>
    @media (max-width: 768px) {
      #main-content-layout {
        grid-template-columns: 1fr !important;
      }
      #toggle-filter-btn {
        display: block !important;
      }
      #filter-panel {
        display: none;
      }
      #filter-panel.show-mobile {
        display: flex !important;
      }
    }
  </style>

  <script>
    import { escapeHtml } from '../lib/escape-html';
    import { foodUrl, dataUrl } from '../lib/url';
    import { renderVendorLink } from '../lib/render-vendor';
    import { decodeSearchIndex } from '../lib/search-index';
    import { searchDocs, stateKey } from '../lib/search-query';

    const appEl = document.getElementById('search-app');
    const dataVersion = appEl?.getAttribute('data-version') || undefined;

    const searchCache = new Map();
    const SEARCH_CACHE_LIMIT = 50;
    let lastSearchKey = null;

    let allLoadedDocs = [];
    let isIndexLoaded = false;
    let isIndexLoading = false;

    let currentPage = 1;
    const PAGE_SIZE = 20;
    let currentFilteredList = [];

    async function loadSearchIndex() {
      if (isIndexLoaded || isIndexLoading) return;
      isIndexLoading = true;
      const loadingBadge = document.getElementById('index-loading-badge');
      if (loadingBadge) loadingBadge.style.display = 'block';

      try {
        const res = await fetch(dataUrl('data/search-index.json', dataVersion));
        const json = await res.json();
        allLoadedDocs = decodeSearchIndex(json);
        isIndexLoaded = true;
      } catch (e) {
        console.error('Failed to load search index:', e);
      } finally {
        isIndexLoading = false;
        if (loadingBadge) loadingBadge.style.display = 'none';
        const hint = document.getElementById('initial-hint');
        if (hint) hint.textContent = '搜尋索引已就緒';
      }
    }

    function getFilterState() {
      return {
        query: document.getElementById('search-input')?.value.trim() || '',
        item: document.getElementById('filter-item')?.value || '',
        pet: document.getElementById('filter-pet')?.value || '',
        source: document.getElementById('filter-source')?.value || '',
        origin: document.getElementById('filter-origin')?.value || '',
      };
    }

    function syncStateToUrl(state) {
      const url = new URL(window.location.href);
      if (state.query) url.searchParams.set('q', state.query); else url.searchParams.delete('q');
      if (state.item) url.searchParams.set('item', state.item); else url.searchParams.delete('item');
      if (state.pet) url.searchParams.set('pet', state.pet); else url.searchParams.delete('pet');
      if (state.source) url.searchParams.set('source', state.source); else url.searchParams.delete('source');
      if (state.origin) url.searchParams.set('origin', state.origin); else url.searchParams.delete('origin');
      window.history.replaceState({}, '', url.toString());
    }

    function restoreStateFromUrl() {
      const p = new URLSearchParams(window.location.search);
      if (p.get('q')) document.getElementById('search-input').value = p.get('q');
      if (p.get('item')) document.getElementById('filter-item').value = p.get('item');
      if (p.get('pet')) document.getElementById('filter-pet').value = p.get('pet');
      if (p.get('source')) document.getElementById('filter-source').value = p.get('source');
      if (p.get('origin')) document.getElementById('filter-origin').value = p.get('origin');
    }

    async function runSearchAndFilter() {
      if (!isIndexLoaded) {
        await loadSearchIndex();
      }

      const state = getFilterState();
      syncStateToUrl(state);

      // 狀態未變（例如重選相同篩選值）直接跳過；命中快取（退格/來回輸入）省掉整趟掃描
      const key = stateKey(state);
      if (key === lastSearchKey) return;
      lastSearchKey = key;

      let filtered = searchCache.get(key);
      if (!filtered) {
        filtered = searchDocs(allLoadedDocs, state);
        searchCache.set(key, filtered);
        if (searchCache.size > SEARCH_CACHE_LIMIT) {
          searchCache.delete(searchCache.keys().next().value);
        }
      }

      currentFilteredList = filtered;
      currentPage = 1;

      document.getElementById('result-count').textContent = filtered.length.toLocaleString();
      renderPage();
    }

    function getCompareList() {
      try {
        const raw = localStorage.getItem('petfood_compare_list');
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function toggleCompare(id, isChecked) {
      try {
        let list = getCompareList();
        if (!Array.isArray(list)) list = [];
        if (isChecked) {
          if (list.length >= 3) {
            alert('比較清單上限為 3 項食品');
            const cb = document.querySelector(`.compare-chk[data-id="${id}"]`);
            if (cb) cb.checked = false;
            return;
          }
          if (!list.includes(id)) list.push(id);
        } else {
          list = list.filter(s => s !== id);
        }
        localStorage.setItem('petfood_compare_list', JSON.stringify(list));
        window.dispatchEvent(new Event('compare-updated'));
      } catch (e) {}
    }

    function renderPage() {
      const container = document.getElementById('results-list');
      container.innerHTML = '';

      if (currentFilteredList.length === 0) {
        container.innerHTML = `
          <div class="card" style="padding: 2rem; text-align: center; color: #6b7280;">
            <p style="font-size: 1.1rem; color: #374151; margin-bottom: 0.5rem;">查無符合條件的食品</p>
            <p style="font-size: 0.85rem;">請嘗試減少篩選條件或更換關鍵字。</p>
          </div>
        `;
        document.getElementById('pagination-bar').style.display = 'none';
        return;
      }

      const start = (currentPage - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;
      const pageItems = currentFilteredList.slice(start, end);
      const compareList = getCompareList();

      for (const p of pageItems) {
        const isCompared = compareList.includes(p.id);
        const card = document.createElement('div');
        card.className = 'card';
        card.style.display = 'flex';
        card.style.flexDirection = 'column';
        card.style.gap = '0.6rem';

        const petTags = (p.pets || []).map(t =>
          `<span class="badge" style="background: var(--primary-light); color: var(--primary-hover); border: 1px solid var(--border);">${escapeHtml(t)}</span>`
        ).join(' ');

        card.innerHTML = `
          <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem;">
            <div>
              <div style="display:flex; align-items:center; gap:0.4rem; flex-wrap:wrap; margin-bottom:0.25rem;">
                <span class="badge" style="background:#f3f4f6; color:#374151;">${escapeHtml(p.item || '')}</span>
                ${petTags}
                <span style="font-size:0.8rem; color:#6b7280;">${escapeHtml(p.id || '')}</span>
              </div>
              <a href="${foodUrl(p.id)}" style="font-size:1.15rem; font-weight:700; color:#111827; text-decoration:none;">${escapeHtml(p.name)}</a>
            </div>

            <label style="display:flex; align-items:center; gap:0.3rem; font-size:0.8rem; cursor:pointer; background:#f9fafb; padding:0.3rem 0.5rem; border-radius:4px; border:1px solid #e5e7eb; white-space:nowrap;">
              <input type="checkbox" class="compare-chk" data-id="${escapeHtml(p.id)}" ${isCompared ? 'checked' : ''} />
              <span>比較</span>
            </label>
          </div>

          <div style="font-size:0.85rem; color:#374151; display:flex; flex-wrap:wrap; gap:1rem;">
            <span>來源：<strong>${escapeHtml(p.source || '')}</strong></span>
            <span>原產地：<strong>${escapeHtml(p.origin || '')}</strong></span>
            <span>廠商：<strong>${renderVendorLink(p.vendorName || '', !!p.vendorRegistered)}</strong></span>
          </div>
        `;

        const chk = card.querySelector('.compare-chk');
        if (chk) {
          chk.addEventListener('change', (e) => {
            toggleCompare(p.id, e.target.checked);
          });
        }

        container.appendChild(card);
      }

      const totalPages = Math.ceil(currentFilteredList.length / PAGE_SIZE);
      const paginationBar = document.getElementById('pagination-bar');
      const pageIndicator = document.getElementById('page-indicator');
      const prevBtn = document.getElementById('prev-page-btn');
      const nextBtn = document.getElementById('next-page-btn');

      if (totalPages > 1) {
        paginationBar.style.display = 'flex';
        pageIndicator.textContent = `第 ${currentPage} / ${totalPages} 頁 (共 ${currentFilteredList.length} 筆)`;
        prevBtn.disabled = currentPage <= 1;
        nextBtn.disabled = currentPage >= totalPages;
      } else {
        paginationBar.style.display = 'none';
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      restoreStateFromUrl();

      const searchInput = document.getElementById('search-input');
      const p = new URLSearchParams(window.location.search);

      if (p.toString().length > 0) {
        runSearchAndFilter();
      } else {
        searchInput.addEventListener('focus', () => {
          if (!isIndexLoaded) {
            runSearchAndFilter();
          }
        }, { once: true });
      }

      let debounceTimer = null;
      searchInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          runSearchAndFilter();
        }, 200);
      });

      ['filter-item', 'filter-pet', 'filter-source', 'filter-origin'].forEach(id => {
        document.getElementById(id)?.addEventListener('change', () => {
          runSearchAndFilter();
        });
      });

      document.getElementById('reset-filter-btn')?.addEventListener('click', () => {
        document.getElementById('search-input').value = '';
        document.getElementById('filter-item').value = '';
        document.getElementById('filter-pet').value = '';
        document.getElementById('filter-source').value = '';
        document.getElementById('filter-origin').value = '';
        runSearchAndFilter();
      });

      const toggleBtn = document.getElementById('toggle-filter-btn');
      const filterPanel = document.getElementById('filter-panel');
      if (toggleBtn && filterPanel) {
        toggleBtn.addEventListener('click', () => {
          filterPanel.classList.toggle('show-mobile');
          toggleBtn.textContent = filterPanel.classList.contains('show-mobile') ? '收合篩選條件 ▴' : '展開篩選條件 ▾';
        });
      }

      document.getElementById('prev-page-btn')?.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          renderPage();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
      document.getElementById('next-page-btn')?.addEventListener('click', () => {
        const totalPages = Math.ceil(currentFilteredList.length / PAGE_SIZE);
        if (currentPage < totalPages) {
          currentPage++;
          renderPage();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });

      window.addEventListener('compare-updated', () => {
        const list = getCompareList();
        document.querySelectorAll('.compare-chk').forEach(chk => {
          const s = chk.getAttribute('data-id');
          chk.checked = list.includes(s);
        });
      });
    });
  </script>
</Layout>
